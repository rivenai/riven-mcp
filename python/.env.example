# ─── Riven MCP Server Configuration ─────────────────────────────────────
# Copy this file to .env and fill in the values.

# Riven API base URL (OpenAI-compatible endpoint)
RIVEN_API_BASE_URL=https://api.rivenai.io/v1

# Riven API key used for server-to-server authentication.
# Generate at: https://dashboard.rivenai.io/api-keys
RIVEN_API_KEY=rvn_your_api_key_here

# ─── MCP Server Settings ─────────────────────────────────────────────────
# Transport mode: "stdio" or "http"
#   stdio — for local MCP clients (Claude Desktop, Cursor, etc.)
#   http  — for remote/HTTP deployment (Streamable HTTP + SSE)
MCP_TRANSPORT=stdio

# HTTP listen host and port (only used when MCP_TRANSPORT=http)
MCP_HOST=0.0.0.0
MCP_PORT=8080

# MCP protocol version advertised during handshake
MCP_PROTOCOL_VERSION=2024-11-05

# ─── Security ────────────────────────────────────────────────────────────
# Comma-separated list of allowed API keys for MCP client auth.
# If empty, no client authentication is enforced (not recommended for production).
# Use "*" to accept any Bearer token (useful behind an auth proxy).
MCP_AUTH_KEYS=

# Rate limiting: max requests per window per client
RATE_LIMIT_MAX_REQUESTS=100
# Rate limiting: window size in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Cost guardrail: max estimated cost (USD) per single chat_completion call
# Requests exceeding this are rejected before execution.
COST_GUARDRAIL_PER_REQUEST_USD=5.00

# Cost guardrail: max spend (USD) per day per API key (0 = unlimited)
COST_GUARDRAIL_DAILY_USD=100.00

# ─── IndexNow (Bing) ─────────────────────────────────────────────────────
# API key registered at https://www.bing.com/indexnow
INDEXNOW_API_KEY=
# Comma-separated list of hostnames you own
INDEXNOW_HOST=rivenai.io

# ─── On-Prem Health Check ────────────────────────────────────────────────
# Base URL for on-prem GLM model health endpoint
ONPREM_HEALTH_URL=http://127.0.0.1:8000/health

# ─── Logging ─────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Enable structured JSON logging (recommended for Docker Swarm / Loki)
LOG_JSON=true
# Audit log file path (set to empty to disable file audit logging)
AUDIT_LOG_PATH=/var/log/riven-mcp/audit.log
